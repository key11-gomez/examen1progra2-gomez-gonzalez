<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="raiz" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.proyecto.controller.ConsultaController">
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 15;" styleClass="encabezado">
            <Label styleClass="titulo" text="Listado de Citas Programadas" />
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" style="-fx-padding: 20;">
            <TableView fx:id="tablaCitas" prefHeight="320" prefWidth="780">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colCliente" prefWidth="180" text="Cliente" />
                    <TableColumn fx:id="colProfesional" prefWidth="180" text="Profesional" />
                    <TableColumn fx:id="colFecha" prefWidth="180" text="Fecha y Hora" />
                    <TableColumn fx:id="colEstado" prefWidth="140" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 15;">
            <Button onAction="#handleVolver" styleClass="boton-principal" text="Volver" />
        </HBox>
    </bottom>
</BorderPane>
